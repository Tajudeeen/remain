# Binance Web3 developer credentials. Never paste real values into this file.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
# Public BSC wallet address only. No private key or seed phrase is needed.
REMAIN_WALLET_ADDRESS=
# A BSC stock-token contract discovered from the current RWA API.
REMAIN_RWA_TOKEN_ADDRESS=
# Explicit sell input in the stock token's smallest units. Not USDT units.
REMAIN_SELL_AMOUNT_RAW=
# No token amount or issuer is guessed from ticker text.
# Holding-free market checks use a public token contract as a CLI argument.
# Wallet, held-stock contract and sell amount may stay blank for that command.
# Optional browser inspection, available only on a loopback local server.
# Keep false until your developer credentials work. No signing or trading.
REMAIN_LOCAL_READ_ONLY=false
# Prepared execution stays disabled until a real CoW payload matches the profile.
REMAIN_EXECUTION_ENABLED=false
REMAIN_COW_PROFILE_REVIEWED=false
# Two independently operated HTTPS BSC RPCs, with historical eth_call support.
REMAIN_RPC_PRIMARY=
REMAIN_RPC_SECONDARY=
# Generate 32 random bytes locally. Preserve this key with encrypted backups.
REMAIN_STORAGE_KEY=
REMAIN_EXECUTION_DB=state/execution.sqlite
# Reviewed JSON pins, see docs/execution.md. Observed hashes alone are untrusted.
REMAIN_CONTRACT_PINS=
# Maximum stock-denominated CoW fee, in the stock's smallest units.
REMAIN_MAXIMUM_STOCK_FEE_RAW=
# Exact browser origin. HTTPS required for public execution hosting.
REMAIN_EXECUTION_ORIGIN=
