{
  "name": "remain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Raise cash. Stay invested. Milestone-zero feasibility kit.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:security": "node scripts/check-security.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:security",
    "smoke:binance": "node --env-file-if-exists=.env.local scripts/smoke-binance.ts",
    "discover:binance": "node --env-file-if-exists=.env.local scripts/discover-binance.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
