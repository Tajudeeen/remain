{
  "name": "remain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Raise cash. Stay invested. Read-only feasibility and bounded cash planning engine.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-web.ts",
    "check:security": "node scripts/check-security.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:web && npm run check:security && npm run check:submission",
    "check:submission": "node scripts/check-submission.ts",
    "submission:status": "node --env-file-if-exists=.env.local scripts/check-submission.ts --require-ready",
    "screen:history": "node scripts/screen-history.ts",
    "smoke:binance": "node --env-file-if-exists=.env.local scripts/smoke-binance.ts",
    "discover:binance": "node --env-file-if-exists=.env.local scripts/discover-binance.ts",
    "market:binance": "node --env-file-if-exists=.env.local scripts/check-binance-market.ts",
    "inspect:binance": "node scripts/inspect-binance.ts",
    "inspect:contracts": "node --env-file-if-exists=.env.local scripts/inspect-contracts.ts",
    "doctor:execution": "node --env-file-if-exists=.env.local scripts/doctor-execution.ts",
    "preflight:execution": "node --env-file-if-exists=.env.local scripts/preflight-execution.ts",
    "backup:execution": "node --env-file-if-exists=.env.local scripts/journal-backup.ts",
    "drill:execution": "node --env-file-if-exists=.env.local scripts/journal-drill.ts",
    "smoke:execution": "node scripts/smoke-execution.ts",
    "check:live-evidence": "node --env-file-if-exists=.env.local scripts/check-live-evidence.ts",
    "rehearse:plan": "node scripts/rehearse-plan.ts",
    "rehearse:orders": "node scripts/rehearse-orders.ts",
    "rehearse:receipt": "node scripts/rehearse-receipt.ts",
    "rehearse:rfq": "node scripts/rehearse-rfq.ts",
    "verify:receipt": "node scripts/verify-receipt.ts",
    "verify:chain-receipt": "node --env-file-if-exists=.env.local scripts/verify-chain-receipt.ts",
    "dev": "node --env-file-if-exists=.env.local scripts/serve-rehearsal.ts",
    "check:web": "node --check web/app.js && node --check web/proof.js && node --check web/response.js && node --check web/live.js && node --check web/wallet.js && node --check web/wallet-providers.js && node --check web/wallet-ui.js && node --check web/position.js && node --check web/preview.js && node --check web/order-review.js && node --check web/trade.js && node --check web/onchain.js && node --check web/balance-evidence.js && node --check web/balance-evidence-ui.js && node --check web/catalog.js && node --check web/service-status.js && node --check web/portfolio.js",
    "test:web": "npm exec --yes --package=agent-browser@0.38.2 -- node scripts/verify-browser.ts",
    "test:execution-web": "npm exec --yes --package=agent-browser@0.38.2 -- node tests/helpers/verify-execution-browser.ts",
    "serve": "node scripts/serve-rehearsal.ts",
    "smoke:deployed": "node scripts/smoke-deployed.ts"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "viem": "2.57.4"
  }
}
